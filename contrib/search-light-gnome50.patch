+// Clutter 18 refuses actor surgery while an input, gesture or signal is still
+// being dispatched, and aborts the shell over it — a lost session on Wayland.
+// show()/hide() reparent the entry, move key focus and connect stage signals,
+// so every one of them that starts inside a handler is pushed past the end of
+// that dispatch. Upstream icedman/search-light#166 lists the sites.
+const afterDispatch = (fn) => {
+  GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
+    try {
+      fn();
+    } catch (err) {
+      // The extension may have been disabled before the tick arrived.
+    }
+    return GLib.SOURCE_REMOVE;
+  });
+};
