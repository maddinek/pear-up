# Matches what the files already use, rather than imposing something new.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Markdown gives trailing spaces a meaning, so leave them alone.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
