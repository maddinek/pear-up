# A throwaway GNOME session for testing, with no display attached.
#
# gnome-shell can run headless against a virtual monitor, so a real shell — real
# panel, real extension loading — can be started, queried and screenshotted with
# no display. That is the only way to catch behaviour rather than mere API
# presence: a symbol can exist and still not be ready when the extension runs,
# which is exactly how the power icon regression survived two fixes.
#
# systemd runs as PID 1 because the shell refuses to finish starting without
# logind: it calls org.freedesktop.login1 while building the end-session dialog,
# and a bare container has nothing to answer.
#
# Build argument picks the GNOME version, via the Fedora release that ships it:
#   45→39  46→40  47→41  48→42  49→43  50→44
ARG FEDORA=44
FROM fedora:${FEDORA}

RUN dnf install -y --setopt=install_weak_deps=False \
        systemd \
        dbus-daemon \
        dbus-tools \
        polkit \
        gnome-shell \
        gjs \
        mesa-dri-drivers \
        mesa-libgbm \
        python3 \
        python3-gobject-base \
        procps-ng \
        pipewire \
        pipewire-pulseaudio \
        wireplumber \
        gstreamer1-plugins-base \
        gstreamer1-plugins-good \
        pipewire-gstreamer \
    && dnf clean all

# Dash to Dock, for the dock magnification checks: each release's own packaged
# version, so the magnifier meets the Dash to Dock that release ships. Installed
# but not enabled — the suite switches it on itself once the panel checks are
# done, so those still run against the stock shell. A layer of its own, so adding
# it did not invalidate the large one above. Its schema is compiled by hand
# because the package scriptlet's warnings about other packages are not worth
# failing a build over.
RUN dnf install -y --setopt=install_weak_deps=False \
        gnome-shell-extension-dash-to-dock \
    && dnf clean all \
    && (glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true)

# Nothing here needs networking, printing, or a boot splash. Masking these keeps
# startup to a couple of seconds and the logs readable.
RUN systemctl mask \
        systemd-remount-fs.service \
        systemd-random-seed.service \
        systemd-machine-id-commit.service \
        dev-hugepages.mount \
        sys-fs-fuse-connections.mount \
        systemd-oomd.service \
    && systemctl set-default multi-user.target \
    && systemctl enable systemd-logind.service

# Everything the suite runs is started through `podman exec`, which puts it in
# PID 1's init.scope — and systemd caps every unit at 15% of the container's
# task limit, 307 threads. Software rendering starts a thread per CPU for each
# GL context, so on a 24-thread machine the shell, the test window and the
# screencast pipeline hit that cap together: thread creation starts failing,
# icons stop loading, gsettings aborts and no recording is ever made. The
# container's own limit still applies.
RUN mkdir -p /etc/systemd/system.conf.d \
    && printf '[Manager]\nDefaultTasksMax=infinity\n' \
        > /etc/systemd/system.conf.d/pear-up-tasks.conf

# Software rendering: there is no GPU in here.
#
# PipeWire matters for more than sound: a headless mutter only composites while
# something is consuming its output, so with no screencast running there are no
# frames and a screenshot comes back empty. PipeWire is what carries them.
#
# Deliberately no wallpapers or applications installed. Adding either changes
# what the compositor has to encode, and PipeWire then fails to agree a format
# with the encoder, leaving no recording at all — so the picture stays a bare
# desktop.
ENV LIBGL_ALWAYS_SOFTWARE=1 \
    GALLIUM_DRIVER=llvmpipe \
    NO_AT_BRIDGE=1

COPY run-tests.sh /usr/local/bin/run-tests.sh
RUN chmod +x /usr/local/bin/run-tests.sh

STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]
