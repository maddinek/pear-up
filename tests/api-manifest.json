{
  "comment": [
    "Every GNOME API this extension depends on, so a target shell version can be",
    "checked before it is claimed in metadata.json. Kept by hand rather than",
    "derived from the source: the point is to state the dependency deliberately,",
    "and a grep cannot tell an API we rely on from a string that merely looks",
    "like one.",
    "",
    "'introspected' entries live in a typelib and can be resolved for real.",
    "'shellInternals' are private JavaScript inside gnome-shell, which no",
    "typelib describes, so they are searched for in the shell's compiled-in",
    "sources instead. Those are the ones that break silently between releases.",
    "",
    "A present symbol still says nothing about behaviour: on GNOME 50",
    "quickSettings._system exists but is not built yet when enable() runs. Only a",
    "running shell catches that."
  ],

  "introspected": {
    "Clutter": [
      "KEY_Escape",
      "EventType",
      "KEY_Control_L",
      "KEY_Shift_L",
      "KEY_Alt_L",
      "KEY_Super_L",
      "KeyState",
      "InputDeviceType",
      "ActorAlign",
      "Orientation",
      "EVENT_STOP",
      "get_default_backend",
      "Actor",
      "Clone",
      "Timeline"
    ],
    "Meta": [
      "WindowType",
      "MaximizeFlags",
      "KeyBindingFlags"
    ],
    "St": [
      "Label",
      "Icon",
      "Bin",
      "BoxLayout",
      "ThemeContext",
      "IconTheme",
      "Widget",
      "Side",
      "Settings"
    ],
    "Shell": [
      "AppSystem",
      "WindowTracker",
      "AppUsage",
      "ActionMode"
    ],
    "GObject": [
      "signal_lookup"
    ],
    "Gio": [
      "AppInfo",
      "DBus",
      "DBusCallFlags",
      "File",
      "FileCreateFlags",
      "Icon",
      "Settings",
      "SettingsSchemaSource"
    ],
    "GLib": [
      "idle_add",
      "source_remove",
      "PRIORITY_DEFAULT_IDLE",
      "SOURCE_REMOVE",
      "spawn_async",
      "shell_parse_argv",
      "SpawnFlags",
      "get_real_name",
      "get_user_name",
      "get_user_data_dir",
      "build_filenamev",
      "get_monotonic_time"
    ]
  },

  "optional": {
    "comment": [
      "Used only where present, so absence is not a failure — but presence is not",
      "permission either, and that distinction cost a release's worth of broken",
      "clicks. Clutter.ClickGesture exists from GNOME 49, while only GNOME 50",
      "delivers panel button presses through one; wiring the search button to a",
      "gesture because the class resolved left it inert on 45 to 49. The code asks",
      "PanelMenu.Button what the shell actually does instead, and only the",
      "integration suite can confirm that answer.",
      "",
      "Reported per version rather than asserted, so the split stays visible."
    ],
    "Clutter": ["ClickGesture", "CursorType"],
    "Meta": ["Cursor"]
  },

  "methods": {
    "comment": "Instance methods, checked on the prototype so a rename is caught.",
    "Meta.Window": [
      "minimize",
      "delete",
      "kill",
      "get_wm_class",
      "get_title",
      "get_window_type",
      "get_id",
      "showing_on_its_workspace",
      "located_on_workspace",
      "get_frame_rect",
      "unmaximize",
      "maximize",
      "is_skip_taskbar"
    ],
    "Clutter.VirtualInputDevice": [
      "notify_keyval"
    ],
    "Clutter.Actor": [
      "get_actions",
      "add_action",
      "get_transformed_position",
      "get_transformed_size",
      "get_allocation_box",
      "get_pivot_point",
      "set_pivot_point",
      "set_scale",
      "insert_child_above",
      "set_child_above_sibling",
      "get_next_sibling",
      "get_paint_opacity",
      "get_preferred_width",
      "get_preferred_height",
      "get_first_child",
      "get_constraints"
    ],
    "Clutter.Timeline": [
      "start",
      "stop"
    ],
    "St.Widget": [
      "get_theme_node",
      "get_style",
      "add_style_class_name",
      "remove_style_class_name"
    ],
    "St.ThemeNode": [
      "get_foreground_color"
    ],
    "Shell.Global": [
      "get_pointer"
    ],
    "Shell.AppUsage": [
      "get_most_used"
    ],
    "Shell.AppSystem": [
      "lookup_app"
    ],
    "Shell.App": [
      "request_quit"
    ],
    "Shell.WindowTracker": [
      "get_window_app"
    ],
    "St.IconTheme": [
      "has_icon"
    ],
    "Gio.File": [
      "load_contents",
      "replace_contents",
      "query_exists",
      "get_basename",
      "get_parent",
      "get_parse_name",
      "get_uri"
    ]
  },

  "properties": {
    "comment": "GObject properties the code reads directly; accessors live on the prototype.",
    "Meta.Window": [
      "minimized",
      "on_all_workspaces"
    ],
    "Clutter.Actor": [
      "mapped",
      "opacity",
      "rotation_angle_z",
      "translation_x",
      "translation_y",
      "x_align",
      "y_align",
      "scale_x",
      "scale_y"
    ],
    "St.Widget": [
      "hover",
      "style_class"
    ],
    "St.Icon": [
      "gicon",
      "fallback_gicon",
      "icon_size",
      "icon_name"
    ],
    "St.Settings": [
      "enable_animations"
    ]
  },

  "eitherOf": {
    "comment": [
      "Alternatives, where one form replaced another. mutter 49 introduced",
      "is_maximized() alongside the older get_maximized() flags getter, so the",
      "code copes with both and only needs one to exist."
    ],
    "Meta.Window maximized state": ["is_maximized", "get_maximized"]
  },

  "shellInternals": [
    "_updatePanel",
    "addKeybinding",
    "removeKeybinding",
    "_rightBox",
    "_centerBox",
    "_leftBox",
    "dateMenu",
    "addToStatusArea",
    "get_current_time",
    "statusArea",
    "quickSettings",
    "_indicator",
    "system-shutdown-symbolic",
    "showAppsButton",
    "canSuspend",
    "canPowerOff",
    "canLockScreen",
    "activateSuspend",
    "activateRestart",
    "activatePowerOff",
    "activateLockScreen",
    "forceUpdate",
    "can-suspend",
    "can-restart",
    "can-power-off",
    "can-lock-screen",
    "org.gnome.SessionManager",
    "openPreferences",
    "connectObject",
    "disconnectObject",
    "searchEntry",
    "extensionManager",
    "stateObj",
    "PopupBaseMenuItem",
    "PopupSubMenuMenuItem",
    "label_actor",
    "popup-menu-icon",
    "dontCreateMenu",
    "pushModal",
    "popModal",
    "uiGroup",
    "get_window_actors",
    "set_cursor",
    "captured-event",
    "findIndexForActor",
    "getWorkAreaForMonitor",
    "monitors-changed",
    "extension-state-changed",
    "EnableExtension",
    "DisableExtension",
    "isLocked",
    "item-drag-begin",
    "item-drag-end",
    "item-drag-cancelled",
    "window-drag-begin",
    "window-drag-end",
    "window-drag-cancelled",
    "xdndHandler",
    "bannerAlignment",
    "_bannerBin",
    "osdWindowManager",
    "_osdWindows",
    "MonitorConstraint",
    "work-area",
    "WorkspaceSwitcherPopup",
    "ThumbnailsBox",
    "_updateShouldShow",
    "_shouldShow",
    "should-show",
    "_thumbnailsBox",
    "_startingUp",
    "runStartupAnimation",
    "startup-complete",
    "_stateAdjustment",
    "ControlsState"
  ],

  "absent": {
    "comment": [
      "APIs that look like they should exist and do not. Listed so a future",
      "change cannot reintroduce a call to one without the check failing.",
      "Clutter has no accelerator parser in any supported version — only",
      "keyval_name, in the opposite direction."
    ],
    "Clutter": ["accelerator_parse"]
  }
}
